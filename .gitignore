# macOS
.DS_Store

# Local environment variables (keep shareable examples)
.env
.env.*
!.env.example
!.env.*.example

# Xcode user settings and generated output
xcuserdata/
*.xcuserstate
/ios/DerivedData/
/ios/build/
*.xcresult

# Swift Package Manager build output
.build/

# Go binaries and generated output
/api/server
/api/cmd/server/server
/api/bin/
/api/build/
/api/tmp/
*.test
/api/coverage.out
/api/coverage.html

# Local Xcode build server configuration (contains machine-specific paths)
/buildServer.json
/.compile
